# Archivo de ejemplo. Copiar como .env local y completar solo en tu equipo.
# NO subir .env, tokens, secretos, emails reales ni payloads reales a GitHub.

# HubSpot: token de una app privada o integración autorizada, modo solo lectura.
HUBSPOT_ACCESS_TOKEN=REEMPLAZAR_SOLO_EN_ARCHIVO_LOCAL

# WhatsApp Business Cloud API: variables para un futuro receptor de webhooks.
WHATSAPP_VERIFY_TOKEN=DEFINIR_TOKEN_LOCAL
WHATSAPP_APP_SECRET=DEFINIR_SECRETO_LOCAL

# Configuración local.
APP_ENV=development
AUDITORIA_CONSERVAR_VALORES_SENSIBLES=false
